<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/li_bg"
    android:orientation="horizontal">

    <ScrollView
        android:id="@+id/li_watch_scroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/li_watch_video" />
            <include layout="@layout/li_watch_meta" />
            <include layout="@layout/li_watch_comments" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/li_watch_up_next" />
</LinearLayout>
