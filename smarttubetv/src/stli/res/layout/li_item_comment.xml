<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/li_comment_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/li_avatar_bg"
        android:contentDescription="Comment author" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/li_comment_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/li_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/li_comment_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/li_text_dim"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/li_comment_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/li_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/li_comment_likes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/li_text_dim"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
